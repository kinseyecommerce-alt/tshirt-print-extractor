{
  "name": "ai-print-extractor-saas",
  "version": "1.0.0",
  "description": "AI Print Extractor SaaS - extract printed artwork from garment images and export as transparent PNG for DTF printing",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:server\" \"npm:client\"",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "NODE_ENV=production node server/index.js",
    "install:all": "npm install && npm --prefix client install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.12",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.52.0",
    "sharp": "^0.33.4",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
