# ============================================================
# AI Print Extractor SaaS - Environment Configuration
# Copy this file to ".env" and fill in the values.
# ============================================================

# Port the Express server listens on (Replit sets this automatically).
PORT=3001

# OpenAI API key used for Vision-based print-area detection.
# Get one at https://platform.openai.com/api-keys
# If left empty, the app falls back to a heuristic (center-crop) detector.
OPENAI_API_KEY=

# OpenAI model used for vision print-area detection (optional override).
# gpt-4o-mini is cheap and works for most single-garment photos. For tricky
# shopping-app screenshots or images with multiple prints, set this to a
# stronger model (e.g. gpt-4o) for more accurate bounding boxes, at higher cost.
OPENAI_MODEL=gpt-4o-mini

# OpenAI model used to GENERATE new designs (Create Design feature).
# Without a key, the app generates a typographic placeholder instead.
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- AI background removal (cutout) ----------------------------------------
# Optional. When a key is set, the extracted print crop is matted by a hosted
# AI segmentation API for world-class clean edges (removes neck/edge junk).
# Without any key, the app falls back to the built-in color-key remover.
# Provider is auto-detected from whichever key is present; override explicitly
# with BG_REMOVAL_PROVIDER = clipdrop | photoroom | removebg.
#   - clipdrop : cheapest (~$0.002/image)     https://clipdrop.co/apis
#   - photoroom: best quality (~$0.02/image)  https://www.photoroom.com/api
#   - removebg : popular (~$0.10-0.20/image)  https://www.remove.bg/api
BG_REMOVAL_PROVIDER=
CLIPDROP_API_KEY=
PHOTOROOM_API_KEY=
REMOVEBG_API_KEY=

# Secret used to sign session cookies. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-secret

# Login credentials (required login for the dashboard).
APP_USERNAME=jagadeesh
APP_PASSWORD=12345

# Node environment: "development" or "production".
NODE_ENV=development

# Optional: comma-separated list of allowed CORS origins for the dev frontend.
CLIENT_ORIGIN=http://localhost:5173
